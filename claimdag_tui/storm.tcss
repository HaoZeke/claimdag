/* Tokyo Night Storm. Resize is layout, not padded SGR rows. */
Screen {
    background: #24283b;
    color: #c0caf5;
}

Header {
    background: #1f2335;
    color: #7aa2f7;
}

Footer {
    background: #1f2335;
    color: #a9b1d6;
}

Tree {
    background: #24283b;
    color: #c0caf5;
}

Tree > .tree--cursor {
    background: #3d59a1;
    color: #c0caf5;
}

Tree > .tree--highlight {
    text-style: bold;
}
