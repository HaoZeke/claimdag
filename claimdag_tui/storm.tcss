/* WorkGraph widgets. Shared tokens: tokyo_night_storm.tcss */
/* Do not bind $panel: Textual default CSS uses hatch: right $panel. */

Screen {
    layout: vertical;
}

Tree {
    height: 1fr;
    width: 1fr;
    background: #24283b;
    color: #c0caf5;
}

Tree > .tree--cursor {
    background: #3d59a1;
    color: #c0caf5;
}

Tree > .tree--highlight {
    text-style: bold;
}

Tree > .tree--guides {
    color: #7aa2f7;
}
